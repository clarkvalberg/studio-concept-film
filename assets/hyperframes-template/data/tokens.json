{
  "typography": {
    "display": { "family": "Inter", "weight": 720, "fallback": "system-ui, sans-serif" },
    "body": { "family": "Inter", "weight": 400, "fallback": "system-ui, sans-serif" },
    "mono": { "family": "JetBrains Mono", "weight": 400, "fallback": "ui-monospace, monospace" }
  },
  "color": {
    "background": "#F4EFE6",
    "ink": "#1A1614",
    "accent": "#2E6F5E",
    "support": "#C9B89A",
    "surface": "#FFF9EF",
    "muted": "#6F675E"
  },
  "motion": {
    "entrance": "power3.out",
    "exit": "power2.in",
    "transition": "power2.inOut",
    "durations": { "fast": 0.25, "medium": 0.45, "slow": 0.75, "hold": 1.5 }
  },
  "spacing": {
    "unit": 8
  }
}
